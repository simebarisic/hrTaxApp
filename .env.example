# Kopiraj u .env i postavi vlastite vrijednosti (.env je u .gitignore).
DB_PASSWORD=promijeni-me
# 127.0.0.1 = samo ovo racunalo. 0.0.0.0 = cijela mreza (tada OBAVEZNO ukljuci basic auth, vidi README).
FRONTEND_BIND=127.0.0.1
# Strike: je li naknada vec sadrzana u "Amount EUR" (true) ili je odvojena (false)
APP_STRIKE_FEE_INCLUDED_IN_AMOUNT=true
